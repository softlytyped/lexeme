(** A binding records where a program binds a name, the role of the name, and the type of
    its value. *)

open! Core

module Codomain : sig
  (** A codomain is the type of a function's result once the function has all of its
      arguments. In particular, the codomain of a field is the type of the field's value. *)
  type t =
    | Boolean
    | Optional_boolean
    | Fallible_boolean
    | Unit of string
    | Other_type of string
    | Unknown
end

module Role : sig
  type t =
    | Variable
    | Function of Codomain.t Lazy.t
    | Field of Codomain.t Lazy.t (** [Field] is a record field that holds no function. *)
    | Type
    | Constructor
    | Test (** [Test] is an inline test, named by its description. *)
end

type t

val name_of : t -> string
val role_of : t -> Role.t
val site_of : t -> Source.Site.t

(** [comment_of binding] returns the comment that follows the name on its line, if any. *)
val comment_of : t -> string option

(** [lines_of binding] returns the lines of code in the definition of a function or a
    test. *)
val lines_of : t -> int option

(** [find source ~offset ?definition ~name role] returns the binding of a name at an
    offset, and counts the lines of code in its definition when it binds a function. But
    it returns [None] where the source does not spell the name at the offset, as for a
    name generated by the compiler. *)
val find
  :  Source.t
  -> offset:int
  -> ?definition:Source.Extent.t
  -> name:string
  -> Role.t
  -> t option

(** [of_test source ~offset ~description ~definition] returns the binding of an inline
    test whose description opens at an offset. *)
val of_test
  :  Source.t
  -> offset:int
  -> description:string
  -> definition:Source.Extent.t
  -> t
