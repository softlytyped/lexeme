# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "A linter for the names and definitions of OCaml and C programs"
description:
  "Lexeme reads each name where a program binds it and asks whether the name reads as English for what it names, and checks the length of each function and how its body branches."
license: "MIT"
homepage: "https://github.com/softlytyped/lexeme"
bug-reports: "https://github.com/softlytyped/lexeme/issues"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.21"}
  "core"
  "core_unix"
  "merlin-lib" {= "5.6.1-504+ox"}
  "ppx_jane"
  "uucp"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/softlytyped/lexeme.git"
x-maintenance-intent: ["(latest)"]
