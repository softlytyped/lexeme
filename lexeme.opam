# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis:
  "A linter for the names, branches and idioms of OCaml and C programs"
description:
  "Lexeme checks that each name in an OCaml or C program is English for what it names. It also checks the length of each function, the way in which each function body branches, chains of let expressions, the use of record fields from other modules, and idioms that have a plainer form."
license: "MIT"
homepage: "https://github.com/softlytyped/lexeme"
bug-reports: "https://github.com/softlytyped/lexeme/issues"
depends: [
  "ocaml" {>= "5.4"}
  "dune" {>= "3.21"}
  "core"
  "core_unix"
  "merlin-lib" {= "5.6.1-504+ox"}
  "ppx_jane"
  "uucp"
  "yojson"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/softlytyped/lexeme.git"
x-maintenance-intent: ["(latest)"]
